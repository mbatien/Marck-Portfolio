# Orders API image. Base images come from the ECR Public Gallery mirror of
# Docker Official Images to avoid Docker Hub pull rate limits in CodeBuild.

# ---- build stage: install dependencies into a virtualenv ----
FROM public.ecr.aws/docker/library/python:3.12-slim AS build
WORKDIR /build
RUN python -m venv /venv
COPY requirements.txt .
RUN /venv/bin/pip install --no-cache-dir -r requirements.txt

# ---- runtime stage: only the virtualenv and the app, run as a non-root user ----
FROM public.ecr.aws/docker/library/python:3.12-slim
ENV PATH="/venv/bin:$PATH" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8080
RUN useradd --uid 10001 --no-create-home --shell /usr/sbin/nologin app
COPY --from=build /venv /venv
WORKDIR /srv
COPY app ./app
USER app
EXPOSE 8080
CMD ["sh", "-c", "exec uvicorn app.main:app --host 0.0.0.0 --port ${PORT} --proxy-headers --forwarded-allow-ips='*'"]
