{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "StartAndTrackBuilds",
      "Effect": "Allow",
      "Action": [
        "codebuild:StartBuild",
        "codebuild:BatchGetBuilds"
      ],
      "Resource": "arn:aws:codebuild:us-east-1:<account-id>:project/webapp-build-project"
    }
  ]
}
