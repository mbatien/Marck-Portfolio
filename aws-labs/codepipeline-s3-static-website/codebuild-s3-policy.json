{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadSourceObject",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::<source-bucket>/*"
    },
    {
      "Sid": "PublishToWebsiteBucket",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::<deployment-bucket>/*"
    }
  ]
}
